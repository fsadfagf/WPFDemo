<Page x:Class="银行管理系统WPF.View.Pages.AddressList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:银行管理系统WPF.View.Pages"
      xmlns:uc="clr-namespace:银行管理系统WPF.usercontrols"
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddressList">

    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--  查询条件  -->
        <GroupBox Grid.Row="0" Margin="0 10" Header="查询条件">
            <StackPanel>
                <WrapPanel>
                    <Label Content="省份:" Style="{StaticResource LableStyle}"/>
                    <TextBox
                        Width="100"
                        Style="{StaticResource TextBoxStyle}"
                        Template="{StaticResource TextBoxCornerTemplate}"
                        Text="{Binding SearchProvince,UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="城市:" Style="{StaticResource LableStyle}" />
                    <TextBox
                        Width="100"
                        Style="{StaticResource TextBoxStyle}"
                        Template="{StaticResource TextBoxCornerTemplate}"
                        Text="{Binding SearchCity,UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="区域:" Style="{StaticResource LableStyle}" />
                    <TextBox
                        Width="100"
                        Style="{StaticResource TextBoxStyle}"
                        Template="{StaticResource TextBoxCornerTemplate}"
                        Text="{Binding SearchArea,UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="状态:" Style="{StaticResource LableStyle}" />
                    <ComboBox
                        Width="100"
                        VerticalAlignment="Center"
                        SelectedValue="{Binding StatusText}"
                        SelectedValuePath="Content">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="正常" />
                        <ComboBoxItem Content="禁用" />
                    </ComboBox>
                </WrapPanel>

                <WrapPanel Height="50">
                    <Label Content="详细地址:" Style="{StaticResource LableStyle}" />
                    <TextBox
                        Width="200"
                        Style="{StaticResource TextBoxStyle}"
                        Template="{StaticResource TextBoxCornerTemplate}"
                        Text="{Binding SearchDetail,UpdateSourceTrigger=PropertyChanged}"/>
                    <Button
                        Content="查询"
                        Style="{StaticResource ButtonStyle}"
                        Template="{StaticResource ButtonCornerTemplate}"
                        Command="{Binding QueryCommand}" />
                   
                    <Button
                        Content="添加"
                        Style="{StaticResource ButtonStyle}"
                        Template="{StaticResource ButtonCornerTemplate}"
                        Command="{Binding AddEditCommand}" />
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!--  地址列表  -->
        <DataGrid
            x:Name="AddressDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Auto"
            IsReadOnly="False"
            ItemsSource="{Binding Addresses}"
            SelectionMode="Single"
            CellEditEnding="AddressDataGrid_CellEditEnding">

            <!--  省份 / 城市 / 区域 / 详细地址 可直接在单元格里双击修改，光标离开即自动入库  -->
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding AddressId}"
                    Header="地址编号"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="1*"
                    MinWidth="90"
                    Binding="{Binding ProvinceName}"
                    Header="省份" />
                <DataGridTextColumn
                    Width="1*"
                    MinWidth="90"
                    Binding="{Binding City}"
                    Header="城市" />
                <DataGridTextColumn
                    Width="1*"
                    MinWidth="90"
                    Binding="{Binding Area}"
                    Header="区域" />
                <DataGridTextColumn
                    Width="2.5*"
                    MinWidth="220"
                    Binding="{Binding DetailAddress}"
                    Header="详细地址" />
                <DataGridTextColumn
                    Width="1.5*"
                    MinWidth="160"
                    Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}"
                    Header="创建时间"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="80"
                    MinWidth="80"
                    Binding="{Binding StatusName}"
                    Header="状态"
                    IsReadOnly="True" />

                <!--  操作列：引用 App.xaml 里的公共模板 OperationColumnTemplate  -->
                <DataGridTemplateColumn
                    Width="240"
                    MinWidth="240"
                    CellTemplate="{StaticResource OperationColumnTemplate}"
                    Header="操作" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  分页控件：PageChanged 事件通过 Interaction 转成 ViewModel 的命令  -->
        <uc:ucPage
            x:Name="AddressPager"
            Grid.Row="2"
            PageIndex="{Binding PageIndex, Mode=TwoWay}"
            TotalCount="{Binding TotalCount, Mode=TwoWay}"
            TotalPage="{Binding TotalPage, Mode=TwoWay}">
            
            <i:Interaction.Triggers>
                <!--  不写 CommandParameter 时，InvokeCommandAction 会把事件参数（含新旧页码）传给命令  -->
                <i:EventTrigger EventName="PageChanged">
                    <i:InvokeCommandAction Command="{Binding PageChangedCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </uc:ucPage>

        <!--  本页统计  -->
        <TextBlock
            Grid.Row="3"
            Margin="10,0"
            VerticalAlignment="Center"
            Text="{Binding Addresses.Count, StringFormat='本页 {0} 条'}" />
    </Grid>
</Page>
