<Window x:Class="银行管理系统WPF.View.AddandUpdateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:银行管理系统WPF.View"
        xmlns:helper="clr-namespace:手写MVVM.Helper"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="280" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="账号:" VerticalAlignment="Center" />
        <TextBox Width="200"
            Grid.Row="0" Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource TextBoxStyle}"
            Template="{StaticResource TextBoxCornerTemplate}"
            Text="{Binding EditUser.Account, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="1" Grid.Column="0" Content="密码:" VerticalAlignment="Center" />
        <!--  PasswordBox 的 Password 不是依赖属性，靠 PasswordBoxHelper 附加属性做双向绑定  -->
        <PasswordBox Width="200"
            Grid.Row="1" Grid.Column="1"
            Margin="0,4"
            VerticalContentAlignment="Center"
            helper:PasswordBoxHelper.Attach="True"
            helper:PasswordBoxHelper.Password="{Binding EditUser.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="2" Grid.Column="0" Content="状态:" VerticalAlignment="Center" />
        <ComboBox Width="200"
            Grid.Row="2" Grid.Column="1"
            Margin="0,4"
            VerticalAlignment="Center"
            SelectedValue="{Binding StatusText}"
            SelectedValuePath="Content">
            <ComboBoxItem Content="正常" />
            <ComboBoxItem Content="禁用" />
        </ComboBox>

        <StackPanel
            Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,20,0"
                Command="{Binding SaveCommand}"
                Content="保存"
                IsDefault="True"
                Style="{StaticResource ButtonStyle}"
                Template="{StaticResource ButtonCornerTemplate}" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="取消"
                IsCancel="True"
                Style="{StaticResource ButtonStyle}"
                Template="{StaticResource ButtonCornerTemplate}" />
        </StackPanel>
    </Grid>
</Window>
