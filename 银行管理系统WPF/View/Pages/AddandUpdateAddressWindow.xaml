<Window x:Class="银行管理系统WPF.View.AddandUpdateAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:银行管理系统WPF.View"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="340" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="省份:" VerticalAlignment="Center" />
        <TextBox Width="200"
            Grid.Row="0" Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource TextBoxStyle}"
            Template="{StaticResource TextBoxCornerTemplate}"
            Text="{Binding EditAddress.ProvinceName, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="1" Grid.Column="0" Content="城市:" VerticalAlignment="Center" />
        <TextBox Width="200"
            Grid.Row="1" Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource TextBoxStyle}"
            Template="{StaticResource TextBoxCornerTemplate}"
            Text="{Binding EditAddress.City, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="2" Grid.Column="0" Content="区域:" VerticalAlignment="Center" />
        <TextBox Width="200"
            Grid.Row="2" Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource TextBoxStyle}"
            Template="{StaticResource TextBoxCornerTemplate}"
            Text="{Binding EditAddress.Area, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="3" Grid.Column="0" Content="详细地址:" VerticalAlignment="Center" />
        <TextBox Width="200"
            Grid.Row="3" Grid.Column="1"
            Margin="0,4"
            Style="{StaticResource TextBoxStyle}"
            Template="{StaticResource TextBoxCornerTemplate}"
            Text="{Binding EditAddress.DetailAddress, UpdateSourceTrigger=PropertyChanged}" />

        <Label Grid.Row="4" Grid.Column="0" Content="状态:" VerticalAlignment="Center" />
        <ComboBox Width="200"
            Grid.Row="4" Grid.Column="1"
            Margin="0,4"
            VerticalAlignment="Center"
            SelectedValue="{Binding StatusText}"
            SelectedValuePath="Content">
            <ComboBoxItem Content="正常" />
            <ComboBoxItem Content="禁用" />
        </ComboBox>

        <StackPanel
            Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,20,0"
                Command="{Binding SaveCommand}"
                Content="保存"
                IsDefault="True"
                Style="{StaticResource ButtonStyle}"
                Template="{StaticResource ButtonCornerTemplate}" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="取消"
                IsCancel="True"
                Style="{StaticResource ButtonStyle}"
                Template="{StaticResource ButtonCornerTemplate}" />
        </StackPanel>
    </Grid>
</Window>
