<Window x:Class="银行管理系统WPF.View.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helper="clr-namespace:手写MVVM.Helper"
        mc:Ignorable="d"
        Title="银行管理系统 - 用户登录"
        Width="420" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=TxtAccount}">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border Grid.Row="0" Background="#800080">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="银行管理系统" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#E8D3F0"
                    Text="BANK MANAGEMENT SYSTEM" />
            </StackPanel>
        </Border>

        <!--  账号 / 密码  -->
        <StackPanel Grid.Row="1" Margin="55,35,55,0">
            <TextBlock Margin="12,0" Text="账号" />
            <TextBox
                x:Name="TxtAccount"
                Height="34"
                Margin="0,6,0,18"
                Padding="15,0"
                VerticalContentAlignment="Center"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Template="{StaticResource TextBoxCornerTemplate}"
                Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="12,0" Text="密码" />
            <PasswordBox
                x:Name="TxtPassword"
                Height="34"
                Margin="0,6,0,0"
                Padding="15,0"
                VerticalContentAlignment="Center"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                helper:PasswordBoxHelper.Attach="True"
                helper:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Template="{StaticResource PasswordBoxCornerTemplate}" />
        </StackPanel>

        <!--  登录 / 退出  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Margin="0,0,25,0"
                Command="{Binding LoginCommand}"
                Content="登 录"
                IsDefault="True"
                Style="{StaticResource ButtonStyle}" />
            <Button
                Command="{Binding ExitCommand}"
                Content="退 出"
                Style="{StaticResource ButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
