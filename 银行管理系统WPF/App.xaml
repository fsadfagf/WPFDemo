<Application x:Class="银行管理系统WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:银行管理系统WPF"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/Resources/Resources/ButtonCornerDictionary.xaml"/>
                <ResourceDictionary Source="/Resources/Resources/ButtonDictionary.xaml"/>
                <ResourceDictionary Source="/Resources/Resources/PasswordBoxCornerDictionary.xaml"/>
                <ResourceDictionary Source="/Resources/Resources/TextBoxCornerDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LableStyle" TargetType="Label">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="#800080" />
            </Style>

            <Style x:Key="TextBlockStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="200" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="15,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Width" Value="150" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="15,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>


            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="90" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="Purple" />
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style
                x:Key="ButtonPageStyle"
                BasedOn="{StaticResource ButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="70" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>

            <!--  表格操作列公共模板：各列表页用 CellTemplate="{StaticResource OperationColumnTemplate}" 引用  -->
            <!--  Command 通过 AncestorType=DataGrid 找到页面的 ViewModel，CommandParameter 传当前行数据  -->
            <DataTemplate x:Key="OperationColumnTemplate">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Command="{Binding DataContext.AddEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        Content="修改"
                        Style="{StaticResource ButtonPageStyle}" />
                    <Button
                        Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        Content="启用"
                        Style="{StaticResource ButtonPageStyle}" />
                    <Button
                        Margin="0"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        Content="删除"
                        Style="{StaticResource ButtonPageStyle}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
