<UserControl x:Class="银行管理系统WPF.usercontrols.ucPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="800">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal">

        <TextBlock VerticalAlignment="Center" Text="共 " />
        <TextBlock
            VerticalAlignment="Center"
            Foreground="#800080"
            Text="{Binding TotalCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock Margin="0,0,15,0" VerticalAlignment="Center" Text=" 条" />

        <Button
            x:Name="BtnFirst"
            Click="BtnFirst_Click"
            Content="首页"
            Style="{StaticResource ButtonPageStyle}" />
        <Button
            x:Name="BtnPrev"
            Click="BtnPrev_Click"
            Content="上一页"
            Style="{StaticResource ButtonPageStyle}" />

        <TextBlock VerticalAlignment="Center" Text="第 " />
        <TextBlock
            VerticalAlignment="Center"
            Foreground="#800080"
            Text="{Binding PageIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock VerticalAlignment="Center" Text=" / " />
        <TextBlock
            VerticalAlignment="Center"
            Foreground="#800080"
            Text="{Binding TotalPage, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock Margin="0,0,15,0" VerticalAlignment="Center" Text=" 页" />

        <Button
            x:Name="BtnNext"
            Click="BtnNext_Click"
            Content="下一页"
            Style="{StaticResource ButtonPageStyle}" />
        <Button
            x:Name="BtnLast"
            Margin="0"
            Click="BtnLast_Click"
            Content="末页"
            Style="{StaticResource ButtonPageStyle}" />

        <TextBlock Margin="15,0,5,0" VerticalAlignment="Center" Text="跳至" />
        <TextBox
            x:Name="TxtJump"
            Width="40"
            Height="24"
            VerticalContentAlignment="Center"
            Text="{Binding PageIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock Margin="3,0,5,0" VerticalAlignment="Center" Text="页" />
        <Button
            Width="50"
            Margin="0"
            Click="BtnJump_Click"
            Content="跳转"
            Style="{StaticResource ButtonPageStyle}" />
    </StackPanel>
</UserControl>
